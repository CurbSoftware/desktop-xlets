{
  "startup": {
    "type": "header",
    "description": "Startup"
  },
  "startup-auto-restore": {
    "type": "checkbox",
    "default": true,
    "description": "Automatically restore startup profile",
    "tooltip": "When Cinnamon starts, load the profile marked as the startup profile"
  },
  "startup-wait-displays": {
    "type": "checkbox",
    "default": true,
    "description": "Wait for required displays",
    "tooltip": "If a profile needs more displays than are connected, wait for them to appear before restoring",
    "dependency": "startup-auto-restore"
  },
  "startup-wait-timeout": {
    "type": "spinbutton",
    "default": 60,
    "min": 5,
    "max": 300,
    "step": 5,
    "units": "seconds",
    "description": "Display wait timeout",
    "tooltip": "How long to wait for missing displays before giving up on startup restore",
    "dependency": "startup-wait-displays"
  },
  "stabilization-delay": {
    "type": "spinbutton",
    "default": 2,
    "min": 0,
    "max": 10,
    "step": 1,
    "units": "seconds",
    "description": "Stabilization delay",
    "tooltip": "Pause after displays settle before restoring, so late monitor churn does not interrupt the restore"
  },

  "profiles": {
    "type": "header",
    "description": "Profiles"
  },
  "capture-applet-settings": {
    "type": "checkbox",
    "default": true,
    "description": "Capture applet settings",
    "tooltip": "Include each applet's own settings inside profiles so they come back with the layout"
  },
  "keep-rollback-history": {
    "type": "checkbox",
    "default": true,
    "description": "Keep rollback history",
    "tooltip": "Before each restore, save the current layout so you can undo"
  },
  "rollback-history-count": {
    "type": "spinbutton",
    "default": 3,
    "min": 1,
    "max": 5,
    "step": 1,
    "units": "snapshots",
    "description": "Number of rollback snapshots",
    "dependency": "keep-rollback-history"
  },

  "notifications": {
    "type": "header",
    "description": "Notifications"
  },
  "notify-success": {
    "type": "checkbox",
    "default": true,
    "description": "Show successful restore notifications"
  },
  "notify-warnings": {
    "type": "checkbox",
    "default": true,
    "description": "Show warning and error notifications"
  },

  "advanced": {
    "type": "header",
    "description": "Advanced"
  },
  "debug-logging": {
    "type": "checkbox",
    "default": false,
    "description": "Enable debug logging",
    "tooltip": "Write detailed entries to ~/.xsession-errors while the applet runs"
  }
}
