{
  "display": {
    "type": "header",
    "description": "Display"
  },
  "display-mode": {
    "type": "combobox",
    "default": "name",
    "description": "Display mode",
    "options": {
      "Name only": "name",
      "Number only": "number",
      "Number + Name": "both"
    }
  },
  "show-menu-on-click": {
    "type": "checkbox",
    "default": true,
    "description": "Show workspace menu on click"
  },
  "scroll-to-switch": {
    "type": "checkbox",
    "default": false,
    "description": "Use scroll wheel to switch workspaces"
  },

  "management": {
    "type": "header",
    "description": "Workspace management"
  },
  "enable-workspace-editing": {
    "type": "checkbox",
    "default": true,
    "description": "Allow adding, removing and renaming workspaces from the menu"
  },
  "confirm-remove": {
    "type": "checkbox",
    "default": true,
    "description": "Confirm before removing a named workspace",
    "dependency": "enable-workspace-editing"
  }
}
